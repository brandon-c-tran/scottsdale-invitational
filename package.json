{
  "name": "scottsdale-invitational",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --mode development",
    "build": "vite build --mode production",
    "build:staging": "vite build --mode staging",
    "deploy": "node scripts/deploy-target.mjs",
    "deploy:staging": "npm run build:staging && wrangler deploy",
    "deploy:production": "npm run build && wrangler deploy",
    "tail": "wrangler tail",
    "test": "node --test tests/m1-foundations.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "check": "node --check shared/core.js && node --check worker/actions.js && node --check worker/index.js && node --check worker/state.js && node --check worker/snapshot.js && node --check worker/tournament.js && node --check scripts/snapshot.mjs && node --check scripts/deploy-target.mjs && node --check scripts/icons.mjs && node --check vite.config.js",
    "snapshot:export": "node scripts/snapshot.mjs export",
    "snapshot:validate": "node scripts/snapshot.mjs validate",
    "snapshot:restore": "node scripts/snapshot.mjs restore",
    "snapshot:recover": "node scripts/snapshot.mjs recover"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.2.0",
    "@vitejs/plugin-react": "^4.4.0",
    "vite": "^6.3.0",
    "wrangler": "^4.20.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "workerd@1.20260714.1": true
  }
}
